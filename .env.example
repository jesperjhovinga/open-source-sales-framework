# Copy to .env (gitignored) and fill in. Illustrates the shape — never commit real values.
#
# Most connectors bind through Claude's MCP and need NO key here (the CRM, email,
# calendar, LinkedIn — see contexts/<org>/connectors.md). These are only for the
# external APIs a skill may call directly outside MCP.

# Apollo — contact/org enrichment in the prospect-sourcing skill (Professional plan).
BD_APOLLO_API_KEY=

# Apify — LinkedIn engagement scraping. Only needed if you automate the export;
# the default flow is a manual JSON drop into the session.
BD_APIFY_API_TOKEN=
